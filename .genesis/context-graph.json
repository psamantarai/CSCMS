  "invariants": {
    "single_money_source": "ledger is the only writable record of money (ARCHITECTURE.md §2) — no diff may add or write a stored balance column (accounts.current_balance, daily_account_balance.closing_balance, etc); every balance is SELECT SUM(amount_paise) FROM ledger.",
    "integer_paise": "money is amount_paise INTEGER, never REAL/float, in both schema and API payloads.",
    "checked_write_isolation": "any check-then-write on ledger state (overdraft guard, single-reversal guard) must run inside BEGIN IMMEDIATE — a bare SELECT then write reads pre-state under react-query's parallel requests (PLAN.md H.1/H.11) and the guard is not real otherwise.",
    "phase_9.5_presentation_only": "while PLAN.md Phase 9.5 (shadcn migration) is active, diffs under src/** must not touch lib/api.ts, lib/queries.ts, lib/format.ts, or a mutation body — those are a separate step, not this one."
  },
  "freeze_boundary": [
    "src/**"
  ]
}
